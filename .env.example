# ==============================================================================
# Smart Gardening System — Environment Configuration Template
# ==============================================================================

# Server Environment & Network
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Security & Authentication
JWT_SECRET=smartgarden_jwt_super_secret_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Database Connection (PostgreSQL / Supabase / Neon / Cloud or Local)
DB_DIALECT=postgres
DB_HOST=aws-0-ap-southeast-2.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.bpfpjnhaawwrgykxduef
DB_PASS=your_database_password
DB_SSL=true
DB_STRICT_DIALECT=false
DB_LOGGING=false
DATABASE_URL=postgresql://postgres.bpfpjnhaawwrgykxduef:your_password@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres

# Supabase Project Configuration (Optional for Supabase Auth/Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# For In-Memory Testing (Automated Tests Default)
# DB_DIALECT=sqlite
# DB_STORAGE=:memory:

# CORS & Frontend Origins
CORS_ORIGIN=*
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:3000

# Weather Provider Configuration
WEATHER_API_PROVIDER=open-meteo
WEATHER_API_KEY=
WEATHER_CACHE_TTL_MINUTES=30

# Demo Seeding Credentials
ADMIN_USER_PASSWORD=Password123!
DEMO_USER_PASSWORD=DemoGarden123!
DEMO_ADMIN_PASSWORD=AdminGarden123!
