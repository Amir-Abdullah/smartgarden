# ==============================================================================
# Smart Gardening System — Environment Configuration Template
# ==============================================================================

# Server Environment & Network
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Security & Authentication
JWT_SECRET=smartgarden_jwt_super_secret_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Database Connection (MariaDB 10.11 LTS)
DB_DIALECT=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smartgarden
DB_USER=smartgarden_user
DB_PASS=smartgarden_pass
DB_LOGGING=false

# For In-Memory Testing (Automated Tests Default)
# DB_DIALECT=sqlite
# DB_STORAGE=:memory:

# CORS & Frontend Origins
CORS_ORIGIN=http://localhost:5173
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:3000

# Weather API Integration (Open-Meteo / WeatherAPI)
WEATHER_API_KEY=
WEATHER_CACHE_TTL_MINUTES=30

# IoT Telemetry & Ingestion
DEVICE_HEARTBEAT_TIMEOUT_SECONDS=300
TELEMETRY_INGEST_RATE_LIMIT=120
