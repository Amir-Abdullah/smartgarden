# ==============================================================================
# Smart Gardening System — Environment Configuration Template
# ==============================================================================

# Server Environment & Network
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Security & Authentication
JWT_SECRET=smartgarden_jwt_super_secret_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Database Connection (PostgreSQL / Supabase / Neon / Cloud or Local)
DB_DIALECT=postgres
DB_HOST=aws-0-ap-southeast-2.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.bpfpjnhaawwrgykxduef
DB_PASS=your_database_password
DB_SSL=true
DB_STRICT_DIALECT=false
DB_LOGGING=false
DB_POOL_MAX=10
DATABASE_URL=postgresql://postgres.bpfpjnhaawwrgykxduef:your_password@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres

# Supabase Project Configuration (Optional for Supabase Auth/Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# For In-Memory Testing (Automated Tests Default)
# DB_DIALECT=sqlite
# DB_STORAGE=:memory:

# Optional Database Connection URI Aliases
# POSTGRES_URL=
# SUPABASE_DB_URL=

# CORS & Frontend Origins
CORS_ORIGIN=*
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:3000
VITE_WS_BASE_URL=
VITE_REALTIME_TRANSPORT=ws
VITE_SUPABASE_URL=

# Weather Provider Configuration
WEATHER_API_PROVIDER=open-meteo
WEATHER_API_KEY=
WEATHER_CACHE_TTL_MINUTES=30

# Demo Seeding Credentials
ADMIN_USER_PASSWORD=Password123!
DEMO_USER_PASSWORD=DemoGarden123!
DEMO_ADMIN_PASSWORD=AdminGarden123!

# Sprint 2 — Realtime, Scheduler, Automation & Email Alerts
REALTIME_TRANSPORT=ws
ENABLE_SCHEDULER=true
CRON_SECRET=replace_with_a_strong_cron_secret_at_least_32_chars
RULE_STALENESS_MINUTES=120

# Sensor Simulator CLI Defaults
SIMULATOR_API_URL=http://127.0.0.1:3000/api/sensors/ingest
SIMULATOR_DEVICE_KEY=
SIMULATOR_DEVICE_UID=
SIMULATOR_INTERVAL_SEC=10

# Nodemailer SMTP Configuration (leaves blank for console-log fallback)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alerts@smartgarden.app

# Sprint 4 — Media Storage (Cloudflare R2 S3-compatible; blank uses DB fallback)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Sprint 4 — Gemini AI (blank uses deterministic agronomy fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
