{
  "name": "smartgarden",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:seed": "npm --prefix backend run db:seed",
    "db:seed:demo": "npm --prefix backend run db:seed:demo",
    "simulate": "node backend/simulator/sensorSimulator.js",
    "test": "npm --prefix backend test",
    "start": "npm --prefix backend start",
    "build:frontend": "npm --prefix frontend run build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/websocket": "^10.0.1",
    "avvio": "^8.3.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.6.1",
    "dottie": "^2.0.6",
    "fastify": "^4.28.1",
    "inflection": "^1.13.4",
    "lodash": "^4.17.21",
    "mariadb": "^3.5.5",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.45",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "pg": "^8.23.1",
    "pg-connection-string": "^2.6.4",
    "pg-hstore": "^2.3.4",
    "retry-as-promised": "^7.0.4",
    "semver": "^7.6.3",
    "sequelize": "^6.37.3",
    "sequelize-pool": "^7.1.0",
    "sqlite3": "^6.0.1",
    "toposort-class": "^1.0.1",
    "validator": "^13.12.0",
    "wkx": "^0.5.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.68.4",
    "@rollup/rollup-linux-x64-musl": "4.68.4",
    "@rollup/rollup-win32-x64-msvc": "4.68.4",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.5",
    "@tailwindcss/oxide-linux-x64-musl": "4.3.5",
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.5",
    "lightningcss-linux-x64-gnu": "1.33.0",
    "lightningcss-linux-x64-musl": "1.33.0",
    "lightningcss-win32-x64-msvc": "1.33.0"
  }
}
